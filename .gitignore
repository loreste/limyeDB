# Binaries
bin/
dist/
release/
*.exe
*.exe~
*.dll
*.so
*.dylib
# Anchor binary names to the repo root so they don't shadow cmd/limyedb/
# and cmd/limyedb-cli/ source directories.
/limyedb
/vexdb

# Node
node_modules/
# Built output for the JS/TS clients is regenerated by npm run build
clients/javascript/dist/
clients/typescript/limyedb/dist/

# Rust and Maven both build into target/
target/
# Cargo.lock is not committed for a library crate
clients/rust/Cargo.lock

# Python build and bytecode artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.tox/

# .NET intermediate output
obj/


# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html

# Profiling
*.prof
cpu.out
mem.out

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code local state
.claude/

# Data directories
data/
*.db
*.log

# Local configs
config.local.yaml
.env
.env.*

# Dependencies (vendor is optional)
# vendor/

# OS files
.DS_Store
Thumbs.db

# Generated files (proto .pb.go files are committed for build reproducibility)

# Secrets
*.pem
*.key
*.crt
!deploy/certs/README.md

# Helm charts (local values)
deploy/helm/*/values-local.yaml
/limyedb-cli
